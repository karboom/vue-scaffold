{
    "$schema": "https://json.schemastore.org/prettierrc",
    "semi": false,
    "singleQuote": true,
    "quoteProps": "as-needed",
    "arrowParens": "avoid",
    "printWidth": 120,
    "tabWidth": 4,
    "trailingComma": "all",
    "endOfLine": "lf",
    "vueIndentScriptAndStyle": false,
    "overrides": [
        {
            "files": ["*.vue"],
            "options": { "tabWidth": 2 }
        }
    ]
}
