# 构建基路径：dev 用 /，生产可填 CDN 绝对地址（如 https://cdn.example.com/app/<hash>/）
VITE_BASE_URL=/

# 接口基地址：dev 建议用相对路径（由 mock 替身承接），prod 填真实后端地址
VITE_API_BASE=/api

# mock 开关：on 时仅 @/api 域实现被替换为同签名替身（传输层不替换），建议只在 .env.development 打开
VITE_API_MOCK=off

# socket.io 连接地址：相对路径表示同源（由网关/代理转发），也可填绝对地址
VITE_WS_URL=/user

# error 日志上报地址：相对 VITE_API_BASE 的路径（如 /api/v1/client-logs）或绝对地址；留空即完全关闭上报
VITE_LOG_REPORT_URL=

# 联邦身份开关：provider 时把 src/federation/*.vue 自动 expose 为远程组件（仅客户端构建注入）；off/留空 = 普通应用
VITE_MF=off

# 联邦宿主清单：`name@entryUrl` 逗号分隔（如 crm@http://localhost:3177/_nuxt/remoteEntry.js）；留空 = 不加载任何远程组件
# 运行期可用 NUXT_PUBLIC_MF_HOSTS 覆盖（远程发版不必重建宿主）
VITE_MF_HOSTS=
