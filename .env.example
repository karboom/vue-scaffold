# 构建基路径：dev 用 /，生产可填 CDN 绝对地址（如 https://cdn.example.com/app/<hash>/）
VITE_BASE_URL=/

# 接口基地址：dev 建议用相对路径（由 mock 替身承接），prod 填真实后端地址
VITE_API_BASE=/api

# mock 开关：on 时仅 @/api 域实现被替换为同签名替身（传输层不替换），建议只在 .env.development 打开
VITE_API_MOCK=off

# socket.io 连接地址：相对路径表示同源（由网关/代理转发），也可填绝对地址
VITE_WS_URL=/user

# error 日志上报地址：相对 VITE_API_BASE 的路径（如 /api/v1/client-logs）或绝对地址；留空即完全关闭上报
VITE_LOG_REPORT_URL=
